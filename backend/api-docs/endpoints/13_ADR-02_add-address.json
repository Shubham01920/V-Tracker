    "commonErrors": [
      "VALIDATION_FAILED (422)",
      "UNAUTHORIZED / TOKEN_EXPIRED / TOKEN_INVALID (401)",
      "RATE_LIMITED (429)",
      "INTERNAL_ERROR (500)"
    ]
  },
  "notes": null,
  "curl": "curl -X POST \"http://localhost:5000/v1/addresses\" \\\n  -H \"Authorization: Bearer $ACCESS_TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"name\":\"Test Owner\",\"phone\":\"9876543210\",\"label\":\"HOME\",\"line1\":\"12, 4th Cross, Koramangala\",\"line2\":\"Near Forum Mall\",\"pincode\":\"560034\",\"city\":\"Bengaluru\",\"state\":\"Karnataka\",\"isDefault\":false}'",
