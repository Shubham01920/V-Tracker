{
  "id": "PUB-01",
  "name": "Public scan page data",
  "group": "Vehicles, QR, contacts and public scan",
  "method": "GET",
  "path": "/v1/public/scan/{qrUuid}",
  "url": "{{baseUrl}}/v1/public/scan/{qrUuid}",
  "auth": "None",
  "webhook": false,
  "calledBy": [
    "Public scan web page"
  ],
  "purpose": "Masked plate, vehicle type and allowed actions for the bystander web page. Never owner data.",
  "request": {
    "headers": {
      "X-Request-Id": "<optional UUID, echoed back>"
    },
    "pathParams": {
      "qrUuid": "uuid | required"
    },
    "query": {},
    "bodyType": null,
    "body": {},
    "example": {
      "url": "/v1/public/scan/9a5f94b3-b01c-477d-8f88-6755590e36bb",
      "headers": {},
      "body": {}
    }
  },
  "responses": {
    "success": {
      "status": 200,
      "example": {
        "data": {
          "maskedPlate": "KA 17 ** 9770",
          "vehicleType": "FOUR_WHEELER",
          "active": true,
          "actions": [
            "CALL",
            "ALERT",
            "REPORT"
          ],
          "reasons": [
            {
              "code": "BLOCKING_ROAD",
              "label": "Vehicle is blocking the road"
            },
            {
              "code": "LIGHTS_ON",
              "label": "Lights are left on"
            },
            {
              "code": "DOORS_OPEN",
              "label": "Doors or windows are open"
            }
          ],
          "message": "This vehicle is protected by V Tracker. Your number stays private."
        },
        "requestId": "eacc8f11-75f2-4caa-b99b-0920eab4b1c4"
      }
    },
    "errors": [
      {
        "code": "QR_NOT_FOUND",
