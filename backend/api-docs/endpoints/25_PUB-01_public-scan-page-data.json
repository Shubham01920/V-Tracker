          "error": {
            "code": "QR_NOT_FOUND",
            "message": "This is not a V Tracker label"
          },
          "requestId": "cd2f5785-54c6-42fe-8844-8986ecbedb23"
        },
        "verifiedByTests": true
      },
      {
        "code": "QR_INACTIVE",
        "status": 410,
        "example": {
          "error": {
            "code": "QR_INACTIVE",
            "message": "This label is no longer active"
