{
  "id": "AUTH-06",
  "name": "Forgot password",
  "group": "Authentication",
  "method": "POST",
  "path": "/v1/auth/forgot-password",
  "url": "{{baseUrl}}/v1/auth/forgot-password",
  "auth": "None",
  "webhook": false,
  "calledBy": [
    "Forgot Password"
  ],
  "purpose": "Send a single-use reset link. Always answers 202 so registered e-mails cannot be discovered.",
  "request": {
    "headers": {
      "Content-Type": "application/json",
      "X-Request-Id": "<optional UUID, echoed back>"
    },
    "pathParams": {},
    "query": {},
    "bodyType": "application/json",
    "body": {
      "email": "string | required"
    },
    "example": {
      "url": "/v1/auth/forgot-password",
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "email": "ghost@example.com"
      }
    }
  },
  "responses": {
    "success": {
      "status": 202,
      "example": {
        "data": {},
        "requestId": "554ddceb-58ca-49aa-aa66-930f30e2e9db"
      }
    },
    "errors": [
      {
        "code": "RATE_LIMITED",
        "status": 429,
        "example": {
          "error": {
            "code": "RATE_LIMITED",
            "message": "Too many requests. Please try again later."
          },
          "requestId": "09518ee3-ff09-482c-ae94-27dcc93ef08e"
        },
        "verifiedByTests": true
      }
    ],
    "commonErrors": [
      "VALIDATION_FAILED (422)",
      "RATE_LIMITED (429)",
      "INTERNAL_ERROR (500)"
    ]
  },
  "notes": "data.devResetToken is returned only outside production.",
  "curl": "curl -X POST \"http://localhost:5000/v1/auth/forgot-password\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"email\":\"ghost@example.com\"}'",
  "testing": {
    "testedBy": [
      "auth.test.js",
      "errors.test.js",
      "ratelimit.test.js"
    ],
    "statusesSeenInTests": [
      "202 OK",
      "429 RATE_LIMITED"
    ],
    "passed": true
  }
}
