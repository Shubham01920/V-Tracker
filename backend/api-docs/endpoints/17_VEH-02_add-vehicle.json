  "auth": "Bearer",
  "webhook": false,
  "calledBy": [
    "Add Vehicle",
    "QR Activation"
  ],
  "purpose": "Create a vehicle. Registration number is normalised (no spaces, upper case) and unique across owners.",
  "request": {
    "headers": {
      "Authorization": "Bearer <accessToken>",
      "Content-Type": "application/json",
      "X-Request-Id": "<optional UUID, echoed back>"
    },
    "pathParams": {},
    "query": {},
    "bodyType": "application/json",
    "body": {
      "registrationNumber": "string | required | e.g. KA17SP1234",
      "type": "TWO_WHEELER|THREE_WHEELER|FOUR_WHEELER|COMMERCIAL | required",
      "model": "string | optional",
      "color": "string | optional"
    },
    "example": {
      "url": "/v1/vehicles",
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "registrationNumber": "KA17SP5981",
        "type": "FOUR_WHEELER",
        "model": "Hyundai Creta"
      }
    }
  },
