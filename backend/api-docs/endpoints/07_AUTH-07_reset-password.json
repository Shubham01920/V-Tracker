{
  "id": "AUTH-07",
  "name": "Reset password",
  "group": "Authentication",
  "method": "POST",
  "path": "/v1/auth/reset-password",
  "url": "{{baseUrl}}/v1/auth/reset-password",
  "auth": "Reset token",
  "webhook": false,
  "calledBy": [
    "Reset Password"
  ],
  "purpose": "Consume the reset token, set a new password and revoke every existing session.",
  "request": {
    "headers": {
      "Authorization": "Bearer <accessToken>",
      "Content-Type": "application/json",
      "X-Request-Id": "<optional UUID, echoed back>"
    },
    "pathParams": {},
    "query": {},
    "bodyType": "application/json",
    "body": {
      "token": "string | required | from the e-mailed link",
      "newPassword": "string | required | min 8, letters + digits"
    },
    "example": {
      "url": "/v1/auth/reset-password",
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "token": "HhHTs2h80THq...",
        "newPassword": "NewSecret99"
      }
    }
  },
  "responses": {
    "success": {
      "status": 204,
      "example": null
    },
    "errors": [
      {
        "code": "TOKEN_INVALID",
        "status": 400,
        "example": {
          "error": {
            "code": "TOKEN_INVALID",
            "message": "Reset link is invalid or was already used"
          },
          "requestId": "78759b4d-b754-485c-92c2-0e856fd825e3"
        },
        "verifiedByTests": true
      },
      {
        "code": "TOKEN_EXPIRED",
        "status": 410,
        "example": {
          "error": {
            "code": "TOKEN_EXPIRED",
            "message": "Reset link has expired"
          },
          "requestId": "cdb748e7-cfc4-41ca-8c3a-84fa764b2963"
        },
        "verifiedByTests": true
      },
      {
        "code": "WEAK_PASSWORD",
        "status": 422,
        "example": {
          "error": {
            "code": "WEAK_PASSWORD",
            "message": "Password must be at least 8 characters and contain a letter and a number",
            "details": [
              {
                "field": "newPassword",
                "issue": "weak"
              }
            ]
          },
          "requestId": "3a229ea4-6381-4e00-8ee0-938311348ed9"
        },
        "verifiedByTests": true
      },
      {
        "code": "VALIDATION_FAILED",
        "status": 422,
        "example": {
          "error": {
            "code": "VALIDATION_FAILED",
            "message": "<human readable message>"
          },
          "requestId": "<uuid>"
        },
        "verifiedByTests": false
      }
    ],
    "commonErrors": [
      "VALIDATION_FAILED (422)",
      "UNAUTHORIZED / TOKEN_EXPIRED / TOKEN_INVALID (401)",
      "RATE_LIMITED (429)",
      "INTERNAL_ERROR (500)"
    ]
  },
  "notes": null,
  "curl": "curl -X POST \"http://localhost:5000/v1/auth/reset-password\" \\\n  -H \"Authorization: Bearer $ACCESS_TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"token\":\"HhHTs2h80THq...\",\"newPassword\":\"NewSecret99\"}'",
  "testing": {
    "testedBy": [
      "auth.test.js",
      "errors.test.js"
    ],
    "statusesSeenInTests": [
      "422 WEAK_PASSWORD",
      "204 OK",
      "400 TOKEN_INVALID",
      "410 TOKEN_EXPIRED"
    ],
    "passed": true
  }
}
