{
  "id": "AUTH-04",
  "name": "Google sign-in",
  "group": "Authentication",
  "method": "POST",
  "path": "/v1/auth/google",
  "url": "{{baseUrl}}/v1/auth/google",
  "auth": "None",
  "webhook": false,
  "calledBy": [
    "Login tab",
    "Signup tab"
  ],
  "purpose": "Exchange a Google ID token for app tokens. New users must also send phone.",
  "request": {
    "headers": {
      "Content-Type": "application/json",
      "X-Request-Id": "<optional UUID, echoed back>"
    },
    "pathParams": {},
    "query": {},
    "bodyType": "application/json",
    "body": {
      "idToken": "string | required | Google ID token (dev: \"mock:<sub>:<email>:<name>\")",
      "phone": "string | required for new users",
      "referralCode": "string | optional",
      "deviceId": "string | optional"
    },
    "example": {
      "url": "/v1/auth/google",
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "idToken": "mock:gsub-6adb6595c2a2a49ecda831e8:user.mvl0z03t205770@example.com:Test Owner"
      }
    }
  },
  "responses": {
    "success": {
      "status": 200,
      "example": {
        "data": {
          "accessToken": "eyJhbGciOiJIUzI1NiIsInR5...<JWT>",
