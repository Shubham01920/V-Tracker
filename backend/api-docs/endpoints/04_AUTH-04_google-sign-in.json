          "expiresIn": 900,
          "tokenType": "Bearer",
          "user": {
            "id": "6adb6595c2a2a49ecda831e8",
            "memberId": "VT100009",
            "fullName": "Test Owner",
            "email": "user.mvl0z03t205770@example.com",
            "emailMasked": "us*****************@example.com",
            "emailVerified": true,
            "phoneMasked": "91******89",
            "phoneLast4": "3689",
            "phoneVerified": true,
            "alertPhoneMasked": "91******89",
            "alertPhoneVerified": true,
            "pendingPhoneVerification": false,
            "pendingAlertPhoneVerification": false,
            "avatarUrl": null,
            "address": null,
            "place": null,
            "city": null,
            "state": null,
            "pincode": null,
            "locality": null,
