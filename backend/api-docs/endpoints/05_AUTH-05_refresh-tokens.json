{
  "id": "AUTH-05",
  "name": "Refresh tokens",
  "group": "Authentication",
  "method": "POST",
  "path": "/v1/auth/refresh",
  "url": "{{baseUrl}}/v1/auth/refresh",
  "auth": "Refresh token",
  "webhook": false,
  "calledBy": [
    "Splash and session check",
    "HTTP interceptor"
  ],
  "purpose": "Rotate the refresh token and get a new access token. Re-using an old refresh token revokes the whole session family.",
  "request": {
    "headers": {
      "Authorization": "Bearer <accessToken>",
      "Content-Type": "application/json",
      "X-Request-Id": "<optional UUID, echoed back>"
    },
    "pathParams": {},
    "query": {},
    "bodyType": "application/json",
    "body": {
      "refreshToken": "string | required"
    },
    "example": {
      "url": "/v1/auth/refresh",
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "refreshToken": "EFQjYXk-q2fg..."
      }
    }
  },
  "responses": {
    "success": {
      "status": 200,
      "example": {
        "data": {
          "accessToken": "eyJhbGciOiJIUzI1NiIsInR5...<JWT>",
          "refreshToken": "dEK7gm-uRfcV...",
          "expiresIn": 900,
          "tokenType": "Bearer"
        },
        "requestId": "90e6c7a6-773a-4d62-9b7f-c3547d7a5f3a"
      }
    },
    "errors": [
      {
        "code": "REFRESH_INVALID",
        "status": 401,
        "example": {
          "error": {
            "code": "REFRESH_INVALID",
            "message": "Session expired. Please log in again."
          },
          "requestId": "431a7d7b-34df-48f2-9b17-c6aff39cd60e"
        },
        "verifiedByTests": true
      },
      {
        "code": "REFRESH_REUSED",
        "status": 401,
        "example": {
          "error": {
            "code": "REFRESH_REUSED",
            "message": "Session was used on another device. Please log in again."
          },
          "requestId": "394b27b8-c8c7-43a9-9ec3-c79d2fccd2fa"
        },
        "verifiedByTests": true
      }
    ],
    "commonErrors": [
      "VALIDATION_FAILED (422)",
      "UNAUTHORIZED / TOKEN_EXPIRED / TOKEN_INVALID (401)",
      "RATE_LIMITED (429)",
      "INTERNAL_ERROR (500)"
    ]
  },
  "notes": null,
  "curl": "curl -X POST \"http://localhost:5000/v1/auth/refresh\" \\\n  -H \"Authorization: Bearer $ACCESS_TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"refreshToken\":\"EFQjYXk-q2fg...\"}'",
  "testing": {
    "testedBy": [
      "auth.test.js"
    ],
    "statusesSeenInTests": [
      "200 OK",
      "401 REFRESH_REUSED",
      "401 REFRESH_INVALID"
    ],
    "passed": true
  }
}
