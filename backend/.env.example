# ------------------------------------------------------------------
# V Tracker API — copy this file to .env and fill in real values.
# In NODE_ENV=production every secret below is REQUIRED (the server refuses to start without them).
# ------------------------------------------------------------------
NODE_ENV=development
PORT=5000
PUBLIC_BASE_URL=http://localhost:5000
SCAN_WEB_BASE_URL=https://scan.vtracker.example/s
# number of proxy hops in front of the API (1 behind Nginx / a load balancer), 0 for direct
TRUST_PROXY=0

MONGO_URI=mongodb://127.0.0.1:27017/vtracker

# --- auth ---
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_SEC=900
REFRESH_TOKEN_EXPIRES_DAYS=30
REAUTH_WINDOW_SEC=900
BCRYPT_ROUNDS=10

# --- encryption at rest (bank numbers, PAN, documents) ---
# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
FILE_URL_SECRET=

# comma separated browser origins allowed by CORS (mobile apps need nothing here)
CORS_ORIGINS=

RATE_LIMIT_ENABLED=true

# --- OTP ---
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_AFTER_SEC=30
# development only: return the OTP / reset token in API responses (never active when NODE_ENV=production)
EXPOSE_DEV_SECRETS=true
# development only: /v1/dev/* simulators for payment, courier, calls, payouts, FASTag
ENABLE_DEV_ROUTES=true

# --- Google sign-in ---
GOOGLE_CLIENT_IDS=
# development only: accept idToken "mock:<sub>:<email>:<name>"
GOOGLE_AUTH_MOCK=true

# --- providers: "mock" works offline. Implement the adapter in src/services/providers/ before switching. ---
PAYMENT_PROVIDER=mock
PAYMENT_KEY_ID=rzp_test_mock
PAYMENT_KEY_SECRET=
PAYMENT_ORDER_TTL_MIN=30
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
PUSH_PROVIDER=mock
TELEPHONY_PROVIDER=mock
TELEPHONY_VIRTUAL_NUMBER=+918000000000
PAYOUT_PROVIDER=mock
FASTAG_PROVIDER=mock
COURIER_PROVIDER=mock

# --- webhook signing secrets (HMAC-SHA256 of "<X-Timestamp>.<raw body>") ---
WEBHOOK_SECRET_PAYMENT=
WEBHOOK_SECRET_COURIER=
WEBHOOK_SECRET_PAYOUT=
WEBHOOK_SECRET_FASTAG=
WEBHOOK_SECRET_TELEPHONY=
WEBHOOK_TOLERANCE_SEC=300

# --- CAPTCHA for the public scan page: mock | turnstile | hcaptcha ---
CAPTCHA_PROVIDER=mock
CAPTCHA_SECRET=

# --- lookups (call public APIs when the local table has no match) ---
PINCODE_API_ENABLED=false
IFSC_API_ENABLED=false

# --- verification (auto = mock provider confirms immediately) ---
KYC_AUTO_VERIFY=true
BANK_AUTO_VERIFY=true
BANK_COOLDOWN_HOURS=24

# --- referral payouts: PLACEHOLDER business rules, keep false until legal review (PDF §0 item 8) ---
REFERRAL_PAYOUTS_ENABLED=false
PAYOUT_AUTO_CREDIT_DAYS=7

# --- app config served by GET /v1/config ---
MAINTENANCE_MODE=false
MIN_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0
SUPPORT_EMAIL=support@vtracker.example
SUPPORT_PHONE=+91 80000 00000
SUPPORT_HOURS=Mon-Sat, 9:00 AM - 7:00 PM IST

UPLOAD_DIR=uploads
LOG_DIR=logs
JOBS_ENABLED=true
BOOTSTRAP_ON_START=true
